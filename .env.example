# ==============================================================================
# KISAN MITRA — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` in the project root to configure external services.
# 
# NOTE FOR SIH PROTOTYPE EVALUATION:
# The prototype runs 100% out of the box in LocalStorage Mode if no variables are set.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CONFIGURATION (OPTIONAL FOR PROTOTYPE / REQUIRED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Obtain these from: Firebase Console -> Project Settings -> General -> Your Apps
# These are client-safe identifiers used by the Firebase JavaScript SDK.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ------------------------------------------------------------------------------
# 2. EXTERNAL AGRICULTURAL & MANDI APIS (FUTURE INTEGRATION)
# ------------------------------------------------------------------------------
# Government of India Open Data Platform (https://data.gov.in)
# APMC Mandi Daily Arrival Rates Resource ID: 9ef84268-d588-465a-a308-a864a43d0070
VITE_AGMARKNET_API_KEY=your_data_gov_in_api_key

# Weather Forecast API (e.g. OpenWeatherMap / IMD Weather Service)
VITE_WEATHER_API_KEY=your_weather_api_key

# ------------------------------------------------------------------------------
# 3. FUTURE PYTHON / FASTAPI MACHINE LEARNING SERVICE
# ------------------------------------------------------------------------------
# Dedicated AI/ML prediction microservice endpoint running Random Forest / LightGBM
VITE_ML_SERVICE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# IMPORTANT SECURITY NOTICE:
# NEVER put private server-side secrets (such as Firebase Service Account private keys,
# payment gateway secret keys, or database passwords) in client-side .env files!
# ------------------------------------------------------------------------------
