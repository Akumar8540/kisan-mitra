rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // KISAN MITRA — FIRESTORE SECURITY RULES
    // Smart India Hackathon (SIH) Prototype Security Architecture
    // =========================================================================
    // EXPLANATION FOR BEGINNER DEVELOPERS:
    // Security rules run server-side in Google Cloud. Even if someone tampers
    // with client-side JavaScript, these rules guarantee that unauthorized
    // users cannot read or modify protected agricultural records.
    // =========================================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    function isFarmer() {
      return isAuthenticated() && getUserData().role == 'farmer';
    }
    
    function isBuyer() {
      return isAuthenticated() && getUserData().role == 'buyer';
    }

    // 1. User Profiles Collection (`users/{userId}`)
    // Each user can read and write only their own account document.
    // Admins can read all profiles to manage system directory.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Farm Profiles Collection (`farms/{userId}`)
    // A farmer can only read and update their own land, soil, and water details.
    match /farms/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // 3. Crop Listings Collection (`cropListings/{listingId}`)
    // Public & buyers can read all 'Active' crop listings.
    // Only the farmer who created the listing (resource.data.farmerId) can edit or delete it.
    match /cropListings/{listingId} {
      allow read: if true; // Public marketplace browsing
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid || isAdmin()
      );
    }

    // 4. Buyer Inquiries Collection (`inquiries/{inquiryId}`)
    // An inquiry can only be read by the buyer who sent it OR the farmer whose listing it targets.
    match /inquiries/{inquiryId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid || 
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 5. Curated Crop Catalog (`cropCatalog/{cropId}`)
    // Publicly readable by all farmers & buyers.
    // Modifiable ONLY by authorized administrators.
    match /cropCatalog/{cropId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Market Prices (`marketPrices/{priceId}`)
    // Public read access for transparent APMC price exploration.
    // Write access restricted to Admin or verified automated data ingestion service.
    match /marketPrices/{priceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Fertilizer Products (`fertilizers/{fertilizerId}`)
    // Publicly readable. Admin-only writes.
    match /fertilizers/{fertilizerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
